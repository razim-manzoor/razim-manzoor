    },
    {
      "name": "Service card",
      "kind": "card",
      "refersTo": "service-card",
      "description": "Scope surface with native disclosure and planner link; shortened specimen copy.",
      "html": "<article class=\"ds-card\"><h4>Websites &amp; digital presence</h4><p>A place for people to find you and take the next step.</p><details><summary class=\"ds-focus\">Scope &amp; deliverables</summary><p>Agreed page structure and responsive interface.</p></details><a class=\"ds-discuss ds-focus\" href=\"#studio\">Discuss this <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M5 12h14m-7-7 7 7-7 7\"/></svg></a></article>",
      "css": ".ds-card{min-width:0;border:1px solid var(--border,rgba(15,23,42,.08));border-radius:14px;background:var(--surface,#fff);color:var(--foreground,#09090b);padding:24px;font-family:var(--font-geist-sans,Geist),ui-sans-serif,system-ui,sans-serif;transition:border-color .2s,background-color .2s,transform .18s cubic-bezier(.16,1,.3,1)}.ds-card h4{margin:0;font-size:20px;font-weight:600;line-height:1.375}.ds-card p{margin-top:12px;color:var(--muted,#526176);font-size:14px;line-height:1.625}.ds-card details{border-top:1px solid var(--border,rgba(15,23,42,.08));padding-top:8px;margin-top:20px}.ds-card summary{min-height:44px;display:flex;align-items:center;color:var(--accent,#047857);font-size:14px;font-weight:600;cursor:pointer}.ds-card summary::after{content:\"\";margin-left:auto;width:7px;height:7px;border-right:1.5px solid currentColor;border-bottom:1.5px solid currentColor;transform:rotate(45deg)}.ds-card details[open] summary::after{transform:rotate(225deg)}.ds-discuss{display:flex;min-height:44px;justify-content:space-between;align-items:center;border-top:1px solid var(--border,rgba(15,23,42,.08));padding-top:12px;margin-top:16px;color:var(--foreground,#09090b);font-size:14px;font-weight:600;text-decoration:none}.ds-discuss svg{transition:transform .15s cubic-bezier(.16,1,.3,1)}.ds-card:focus-within{border-color:var(--accent,#047857);transform:translateY(-3px);transition:none}.ds-discuss:focus-visible svg{transform:translateX(3px)}@media(hover:hover) and (pointer:fine){.ds-card:hover{border-color:var(--accent,#047857);transform:translateY(-3px)}.ds-discuss:hover svg{transform:translateX(3px)}}.ds-focus:focus-visible{outline:none;box-shadow:0 0 0 2px var(--background,#f8fafc),0 0 0 4px var(--primary,#047857)}@media(min-width:768px){.ds-card{padding:28px}}@media(prefers-reduced-motion:reduce){.ds-card,.ds-discuss svg{transition:none;transform:none!important}}"
    },
