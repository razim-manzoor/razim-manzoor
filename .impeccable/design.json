      "css": ".ds-primary{display:inline-flex;min-height:48px;align-items:center;justify-content:center;gap:8px;border-radius:10px;padding:12px 20px;font-size:14px;font-weight:600;font-family:var(--font-geist-sans,Geist),ui-sans-serif,system-ui,sans-serif;transition:background-color .2s,color .2s,border-color .2s;border:0;background:var(--primary,#047857);color:var(--on-primary,#fff)}.ds-primary:hover{background:var(--primary-hover,#065f46)}.ds-focus:focus-visible{outline:none;box-shadow:0 0 0 2px var(--background,#f8fafc),0 0 0 4px var(--primary,#047857)}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
