      "css": ".ds-secondary{display:inline-flex;min-height:48px;align-items:center;justify-content:center;gap:8px;border-radius:10px;padding:12px 20px;font-size:14px;font-weight:600;font-family:var(--font-geist-sans,Geist),ui-sans-serif,system-ui,sans-serif;transition:background-color .2s,color .2s,border-color .2s;border:1px solid var(--border,rgba(15,23,42,.08));background:var(--surface,#fff);color:var(--foreground,#09090b)}.ds-secondary:hover{background:var(--surface-hover,#f1f5f9);border-color:var(--muted,#526176)}.ds-focus:focus-visible{outline:none;box-shadow:0 0 0 2px var(--background,#f8fafc),0 0 0 4px var(--primary,#047857)}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}}"
    },
    {
      "name": "Project field",
      "kind": "input",
      "refersTo": "input",
      "description": "Optional labelled planner field.",
      "html": "<label class=\"ds-label\" for=\"ds-name\">Your name or company</label><input class=\"ds-input ds-focus\" id=\"ds-name\" placeholder=\"For example, Alex / Acme\" autocomplete=\"name\">",
      "css": ".ds-label{display:block;margin-bottom:8px;font-size:14px;font-weight:500;font-family:var(--font-geist-sans,Geist),ui-sans-serif,system-ui,sans-serif;color:var(--foreground,#09090b)}.ds-input{width:calc(100% - 26px);border:1px solid var(--control-border,#77869b);border-radius:8px;background:var(--background,#f8fafc);color:var(--foreground,#09090b);padding:12px;font-size:16px;font-family:var(--font-geist-sans,Geist),ui-sans-serif,system-ui,sans-serif;caret-color:var(--accent,#047857)}.ds-input::placeholder{color:var(--muted,#526176);opacity:1}.ds-input:hover{border-color:var(--control-border,#77869b)}.ds-focus:focus-visible{outline:none;box-shadow:0 0 0 2px var(--background,#f8fafc),0 0 0 4px var(--primary,#047857)}"
    },
