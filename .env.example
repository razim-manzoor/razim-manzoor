# Resend API Key for sending enquiry emails (from https://resend.com)
RESEND_API_KEY=re_your_api_key_here

# Recipient email address
CONTACT_EMAIL=your_email@example.com

# Sender email address (e.g. Portfolio <onboarding@resend.dev> or contact@yourdomain.com)
RESEND_FROM_EMAIL=Portfolio Enquiry <onboarding@resend.dev>
